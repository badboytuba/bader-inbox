<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="bader_inbox.InboxMain" owl="1">
        <div class="bader-inbox-container d-flex">
            <!-- LEFT PANEL: Conversations -->
            <div class="bader-inbox-left">
                <div class="panel-header">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <h3 class="mb-0">Conversas</h3>
                        <button class="btn btn-sm btn-success" t-on-click="openAddChannelModal" title="Adicionar Canal WhatsApp">
                            <i class="fa fa-plus"/> Canal
                        </button>
                        <button class="btn btn-sm btn-new-conversation" t-on-click="openNewConversationModal" title="Nova Conversa">
                            <i class="fa fa-comment"/> +
                        </button>
                    </div>
                    
                    <!-- Channel Status -->
                    <div t-if="state.channels.length" class="channel-status mb-2">
                        <t t-foreach="state.channels" t-as="ch" t-key="ch.id">
                            <span t-attf-class="badge {{ ch.state === 'connected' ? 'bg-success' : 'bg-warning' }} me-1">
                                <i class="fa fa-whatsapp"/> <t t-esc="ch.name"/>
                            </span>
                        </t>
                    </div>
                    <div t-else="" class="alert alert-info py-2 small">
                        <i class="fa fa-info-circle"/> Nenhum canal conectado. Clique em "+ Canal" para adicionar.
                    </div>
                    
                    <div class="filter-tabs">
                        <button t-attf-class="filter-tab {{ state.filter === 'all' ? 'active' : '' }}" t-on-click="() => this.setFilter('all')">
                            Todas
                        </button>
                        <button t-attf-class="filter-tab {{ state.filter === 'unread' ? 'active' : '' }}" t-on-click="() => this.setFilter('unread')">
                            <i class="fa fa-circle text-success me-1" style="font-size: 8px;"/> Não lidas
                        </button>
                        <button t-attf-class="filter-tab {{ state.filter === 'mine' ? 'active' : '' }}" t-on-click="() => this.setFilter('mine')">
                            Minhas
                        </button>
                    </div>
                </div>

                <div class="conversations-list">
                    <div t-if="state.loadingConversations" class="empty-state">
                            <i class="fa fa-spinner fa-spin"/>
                            <p>Carregando...</p>
                        </div>
                    <div t-elif="!filteredConversations.length" class="empty-state">
                            <i class="fa fa-inbox"/>
                            <p>Nenhuma conversa</p>
                        </div>
                    <div t-else="" class="conversations-items">
                        <t t-foreach="filteredConversations" t-as="conv" t-key="conv.id">
                            <div t-attf-class="conversation-item {{ state.selectedConversation?.id === conv.id ? 'active' : '' }}" 
                                 t-on-click="() => this.selectConversation(conv)">
                                <div t-attf-class="conv-avatar {{ getAvatarColor(conv.id) }}">
                                    <t t-esc="getInitials(conv.computed_name || conv.phone)"/>
                                    <div class="status-dot online"/>
                                </div>
                                <div class="conv-content">
                                    <div class="conv-header">
                                        <span class="conv-name" t-esc="conv.computed_name || conv.phone"/>
                                        <span class="conv-time" t-esc="formatTime(conv.last_message_date)"/>
                                    </div>
                                    <div class="conv-preview">
                                        <span class="conv-message" t-esc="conv.last_message || 'Nova conversa'"/>
                                        <span t-if="conv.unread_count > 0" class="conv-badge" t-esc="conv.unread_count"/>
                                    </div>
                                </div>
                            </div>
                        </t>
                    </div>
                </div>
            </div>

            <!-- CENTER PANEL: Chat or Kanban -->
            <div class="bader-inbox-center">
                <!-- View Mode Toggle -->
                <div class="view-mode-toggle">
                    <button t-attf-class="toggle-btn {{ state.viewMode === 'list' ? 'active' : '' }}" 
                            t-on-click="() => this.setViewMode('list')" title="Vista Chat">
                        <i class="fa fa-comments"/> Chat
                    </button>
                    <button t-attf-class="toggle-btn {{ state.viewMode === 'kanban' ? 'active' : '' }}" 
                            t-on-click="() => this.setViewMode('kanban')" title="Vista Kanban">
                        <i class="fa fa-columns"/> Kanban
                    </button>
                </div>

                <!-- ═══ LIST VIEW (Chat) ═══ -->
                <div t-if="state.viewMode === 'list'" class="list-view-container">
                    <div t-if="state.selectedConversation" class="chat-view"
                         t-on-dragenter="onDragEnterChat" t-on-dragover="onDragOverChat"
                         t-on-dragleave="onDragLeaveChat" t-on-drop="onDropChat">
                        <!-- Drag & Drop Overlay -->
                        <div t-if="state.isDragOver" class="drop-zone-overlay">
                            <div class="drop-zone-content">
                                <i class="fa fa-cloud-upload fa-3x"/>
                                <p>Solte o arquivo aqui</p>
                            </div>
                        </div>
                        <div class="chat-header">
                            <div class="chat-contact">
                                <div t-attf-class="contact-avatar {{ getAvatarColor(state.selectedConversation.id) }}">
                                    <t t-esc="getInitials(state.selectedConversation.computed_name || state.selectedConversation.phone)"/>
                                </div>
                                <div class="contact-info">
                                    <h4 t-esc="state.selectedConversation.computed_name || state.selectedConversation.phone"/>
                                    <p t-esc="state.selectedConversation.phone"/>
                                </div>
                            </div>
                            <div class="chat-actions">
                                <button class="btn-chat-action" title="Buscar" t-on-click="toggleMessageSearch">
                                    <i class="fa fa-search"/>
                                </button>
                                <button class="btn-chat-action" title="Atribuir" t-on-click="assignConversation">
                                    <i class="fa fa-user-plus"/>
                                </button>
                                <button class="btn-chat-action" title="Resolver" t-on-click="resolveConversation">
                                    <i class="fa fa-check"/>
                                </button>
                                <button class="btn-chat-action" t-on-click="toggleContactPanel" t-att-title="state.showContactPanel ? 'Esconder detalhes' : 'Ver detalhes'">
                                    <i class="fa fa-user"/>
                                </button>
                            </div>
                        </div>

                        <!-- Message Search Bar -->
                        <div t-if="state.showMessageSearch" class="message-search-bar">
                            <div class="search-input-wrapper">
                                <i class="fa fa-search"/>
                                <input type="text" placeholder="Buscar mensagem..." 
                                       t-model="state.messageSearchQuery"
                                       t-on-keydown="onSearchKeydown"/>
                                <span t-if="state.messageSearchResults.length" class="search-count">
                                    <t t-esc="state.messageSearchIndex + 1"/> de <t t-esc="state.messageSearchResults.length"/>
                                </span>
                            </div>
                            <div class="search-nav">
                                <button class="btn-search-nav" t-on-click="() => navigateSearchResult('prev')" t-att-disabled="state.messageSearchIndex === 0">
                                    <i class="fa fa-chevron-up"/>
                                </button>
                                <button class="btn-search-nav" t-on-click="() => navigateSearchResult('next')" t-att-disabled="state.messageSearchIndex >= state.messageSearchResults.length - 1">
                                    <i class="fa fa-chevron-down"/>
                                </button>
                                <button class="btn-search-nav" t-on-click="toggleMessageSearch">
                                    <i class="fa fa-times"/>
                                </button>
                            </div>
                        </div>

                        <div class="chat-messages" t-ref="messagesContainer">
                            <div t-if="state.loadingMessages" class="text-center p-4">
                                <i class="fa fa-spinner fa-spin fa-2x"/>
                            </div>
                            <div t-else="" class="messages-list">
                                <t t-foreach="state.messages" t-as="msg" t-key="msg.id">
                                    <div t-attf-class="message {{ msg.direction === 'out' ? 'outgoing' : 'incoming' }}" t-att-data-msg-id="msg.id">
                                        <div class="message-bubble">
                                            <!-- Media content based on message type -->
                                            <div class="message-content-wrapper">
                                                <div t-if="msg.message_type === 'image'" class="message-media">
                                                    <img t-att-src="getMediaUrl(msg)" class="message-image" 
                                                         t-on-click="() => window.open(getMediaUrl(msg), '_blank')"
                                                         alt="Image" loading="lazy"/>
                                                </div>
                                                <div t-if="msg.message_type === 'audio'" class="message-media">
                                                    <audio controls="" preload="none">
                                                        <source t-att-src="getMediaUrl(msg)" t-att-type="msg.media_mimetype || 'audio/ogg'"/>
                                                    </audio>
                                                </div>
                                                <div t-if="msg.message_type === 'video'" class="message-media">
                                                    <video controls="" preload="none" class="message-video">
                                                        <source t-att-src="getMediaUrl(msg)" t-att-type="msg.media_mimetype || 'video/mp4'"/>
                                                    </video>
                                                </div>
                                                <div t-if="msg.message_type === 'document'" class="message-document">
                                                    <a t-att-href="getMediaUrl(msg)" target="_blank" class="document-link">
                                                        <i class="fa fa-file-o"/>
                                                        <span t-esc="msg.media_filename || 'Document'"/>
                                                    </a>
                                                </div>
                                                <div t-if="msg.message_type === 'location'" class="message-location">
                                                    <i class="fa fa-map-marker"/>
                                                    <span t-esc="msg.content || 'Location'"/>
                                                </div>
                                                <div t-if="msg.content and msg.message_type !== 'location'" class="message-text" t-esc="msg.content"/>
                                            </div>
                                            <div class="message-meta">
                                                <span class="message-time" t-esc="formatTime(msg.create_date)"/>
                                                <span t-if="msg.direction === 'out'" t-attf-class="message-status {{ msg.status === 'read' ? 'read' : msg.status === 'delivered' ? 'delivered' : msg.status === 'failed' ? 'failed' : 'sent' }}">
                                                    <span t-if="msg.status === 'failed'"><i class="fa fa-times"/></span>
                                                    <span t-elif="msg.status === 'delivered' or msg.status === 'read'"><i class="fa fa-check"/><i class="fa fa-check"/></span>
                                                    <span t-else=""><i class="fa fa-check"/></span>
                                                </span>
                                                <span t-else="" class="message-status-placeholder"/>
                                            </div>
                                        </div>
                                    </div>
                                </t>
                            </div>
                        </div>

                        <div class="chat-composer">
                            <!-- Attachment Preview -->
                            <div t-if="state.attachment" class="attachment-preview">
                                <div class="preview-content">
                                    <img t-if="state.attachment.type === 'image'" t-att-src="state.attachment.preview" class="preview-image"/>
                                    <div t-else="" class="preview-file">
                                        <i t-attf-class="fa {{ state.attachment.type === 'audio' ? 'fa-music' : state.attachment.type === 'video' ? 'fa-video-camera' : 'fa-file' }}"/>
                                    </div>
                                    <span class="preview-name" t-esc="state.attachment.name"/>
                                </div>
                                <button class="btn-remove-attachment" t-on-click="removeAttachment">
                                    <i class="fa fa-times"/>
                                </button>
                            </div>

                            <!-- Quick Reply Picker -->
                            <div t-if="state.showQuickReplies" class="quick-reply-picker">
                                <div class="qr-header">
                                    <i class="fa fa-bolt"/>
                                    <span>Respostas Rápidas</span>
                                </div>
                                <div class="qr-list">
                                    <t t-foreach="filteredQuickReplies()" t-as="qr" t-key="qr.id">
                                        <div t-attf-class="qr-item {{ qr_index === state.quickReplyIndex ? 'active' : '' }}"
                                             t-on-click="() => this.selectQuickReply(qr)">
                                            <div class="qr-shortcut">
                                                <span t-if="qr.shortcut" class="qr-slash" t-esc="qr.shortcut"/>
                                                <span class="qr-name" t-esc="qr.name"/>
                                            </div>
                                            <div class="qr-preview" t-esc="qr.content.substring(0, 80) + (qr.content.length > 80 ? '...' : '')"/>
                                        </div>
                                    </t>
                                    <div t-if="!filteredQuickReplies().length" class="qr-empty">
                                        <i class="fa fa-info-circle"/>
                                        Nenhuma resposta rápida encontrada
                                    </div>
                                </div>
                            </div>

                            <!-- Emoji Picker -->
                            <div t-if="state.showEmojiPicker" class="emoji-picker">
                                <div class="emoji-tabs">
                                    <t t-foreach="getEmojiCategories()" t-as="cat" t-key="cat.id">
                                        <button t-attf-class="emoji-tab {{ state.emojiCategory === cat.id ? 'active' : '' }}"
                                                t-on-click="() => { this.state.emojiCategory = cat.id; }"
                                                t-att-title="cat.label">
                                            <t t-esc="cat.icon"/>
                                        </button>
                                    </t>
                                </div>
                                <div class="emoji-grid">
                                    <t t-foreach="getEmojisForCategory(state.emojiCategory)" t-as="emoji" t-key="emoji_index">
                                        <button class="emoji-btn" t-on-click="() => this.onEmojiSelected(emoji)">
                                            <t t-esc="emoji"/>
                                        </button>
                                    </t>
                                </div>
                            </div>

                            <div class="composer-actions">
                                <button class="btn-composer" title="Emoji" t-on-click="toggleEmojiPicker">
                                    <i class="fa fa-smile-o"/>
                                </button>
                                <button class="btn-composer" title="Anexar arquivo" t-on-click="triggerFileInput">
                                    <i class="fa fa-paperclip"/>
                                </button>
                                <input type="file" t-ref="fileInput" class="d-none" t-on-change="onFileSelected"/>
                            </div>
                            <div class="composer-input">
                                <textarea rows="1" placeholder="Escreva uma mensagem... (/ para respostas rápidas)" 
                                    t-ref="composerTextarea"
                                    t-model="state.composerText" 
                                    t-on-keydown="onComposerKeydown"
                                    t-on-input="onComposerInput"/>
                            </div>
                            <button class="btn-send" t-on-click="sendMessage" t-att-disabled="state.sendingMessage || (!state.composerText.trim() and !state.attachment)">
                                <i t-attf-class="fa {{ state.sendingMessage ? 'fa-spinner fa-spin' : 'fa-paper-plane' }}"/>
                            </button>
                        </div>
                    </div>
                    <div t-else="" class="empty-chat">
                        <div class="empty-icon">
                            <i class="fa fa-comments"/>
                        </div>
                        <h3>Bader Inbox</h3>
                        <p>Selecione uma conversa para começar</p>
                        <div t-if="!state.channels.length" class="connect-cta">
                            <button class="btn btn-success btn-lg mt-3" t-on-click="openAddChannelModal">
                                <i class="fa fa-whatsapp"/> Conectar WhatsApp
                            </button>
                        </div>
                    </div>
                </div>

                <!-- ═══ KANBAN VIEW ═══ -->
                <div t-if="state.viewMode === 'kanban'" class="kanban-view-container">
                    <div class="kanban-header">
                        <div class="pipeline-selector">
                            <label>Pipeline:</label>
                            <select class="form-select form-select-sm" 
                                    t-on-change="onPipelineSelectChange">
                                <t t-foreach="state.pipelines" t-as="p" t-key="p.id">
                                    <option t-att-value="p.id" t-att-selected="p.id === state.selectedPipelineId">
                                        <t t-esc="p.icon"/> <t t-esc="p.name"/>
                                    </option>
                                </t>
                            </select>
                        </div>
                        <div t-if="!state.pipelines.length" class="alert alert-info py-2 small mb-0">
                            <i class="fa fa-info-circle"/> Crie pipelines em ⚙️ Configuração → Gerir Pipelines
                        </div>
                    </div>

                    <div class="kanban-board">
                        <div t-if="state.loadingKanban" class="text-center p-4 w-100">
                                <i class="fa fa-spinner fa-spin fa-2x"/>
                            </div>
                        <div t-elif="state.kanbanStages.length" class="kanban-stages">
                            <t t-foreach="state.kanbanStages" t-as="stage" t-key="stage.id">
                                <div class="kanban-column"
                                     t-on-dragover="onDragOver"
                                     t-on-dragleave="onDragLeave"
                                     t-on-drop="(ev) => this.onDrop(ev, stage.id)">
                                    <div class="kanban-column-header">
                                        <span class="column-title" t-esc="stage.name"/>
                                        <span class="column-count badge bg-secondary">
                                            <t t-esc="(state.kanbanCards[stage.id] || []).length"/>
                                        </span>
                                    </div>
                                    <div class="kanban-column-body">
                                        <t t-foreach="state.kanbanCards[stage.id] || []" t-as="card" t-key="card.id">
                                            <div class="kanban-card" draggable="true"
                                                 t-on-dragstart="(ev) => this.onDragStart(ev, card)"
                                                 t-on-dragend="onDragEnd"
                                                 t-on-click="() => this.onKanbanCardClick(card)">
                                                <div class="card-header-row">
                                                    <strong t-esc="card.contact_name || 'Unknown'"/>
                                                    <span t-if="card.unread_count > 0" class="badge bg-danger badge-sm">
                                                        <t t-esc="card.unread_count"/>
                                                    </span>
                                                </div>
                                                <div class="card-phone text-muted small">
                                                    📱 <t t-esc="card.phone"/>
                                                </div>
                                                <div t-if="card.last_message" class="card-preview">
                                                    <t t-esc="(card.last_message || '').substring(0, 60)"/>
                                                    <span t-if="(card.last_message || '').length > 60">...</span>
                                                </div>
                                                <div class="card-footer">
                                                    <span t-if="card.assigned_user_id" class="card-user small text-muted">
                                                        <i class="fa fa-user"/> <t t-esc="card.assigned_user_id[1]"/>
                                                    </span>
                                                </div>
                                            </div>
                                        </t>
                                    </div>
                                </div>
                            </t>
                        </div>
                        <div t-else="" class="empty-chat">
                                <div class="empty-icon">
                                    <i class="fa fa-columns"/>
                                </div>
                                <h3>Sem Pipeline Selecionado</h3>
                                <p>Selecione ou crie um pipeline em ⚙️ Configuração</p>
                            </div>
                    </div>
                </div>
            </div>

            <!-- RIGHT PANEL: Contact Details -->
            <div t-if="state.showContactPanel and state.selectedConversation" class="bader-inbox-right">
                    <div class="contact-header">
                        <div t-attf-class="contact-avatar-large {{ getAvatarColor(state.selectedConversation.id) }}">
                            <t t-esc="getInitials(state.selectedConversation.computed_name || state.selectedConversation.phone)"/>
                        </div>
                        <h3 t-esc="state.selectedConversation.computed_name || 'Desconhecido'"/>
                        <p t-esc="state.selectedConversation.phone"/>
                    </div>

                    <div class="contact-section">
                        <h4>Informações</h4>
                        <div class="info-row">
                            <i class="fa fa-phone"/>
                            <span class="info-value link" t-esc="state.selectedConversation.phone"/>
                        </div>
                        <div class="info-row">
                            <i class="fa fa-whatsapp"/>
                            <span class="info-label">Canal</span>
                            <span class="info-value" t-esc="state.selectedConversation.channel_id?.[1] || 'WhatsApp'"/>
                        </div>
                        <div class="info-row">
                            <i class="fa fa-user"/>
                            <span class="info-label">Atribuído</span>
                            <span class="info-value" t-esc="state.selectedConversation.assigned_user_id?.[1] || 'Não atribuído'"/>
                        </div>
                    </div>

                    <!-- Pipeline Assignments Section -->
                    <div class="contact-section">
                        <div class="d-flex justify-content-between align-items-center">
                            <h4>📊 Fluxos</h4>
                            <button class="btn btn-sm btn-outline-primary" t-on-click="openAddToPipelineModal" 
                                    t-att-disabled="!availablePipelinesForModal.length"
                                    title="Adicionar a um fluxo">
                                <i class="fa fa-plus"/>
                            </button>
                        </div>
                        <div t-if="state.loadingPipelines" class="text-center py-2">
                            <i class="fa fa-spinner fa-spin"/>
                        </div>
                        <div t-elif="state.convPipelines.length" class="pipelines-list">
                            <t t-foreach="state.convPipelines" t-as="cp" t-key="cp.id">
                                <div class="pipeline-assignment-row">
                                    <div class="pipeline-info">
                                        <strong t-esc="cp.pipeline_id[1]"/>
                                        <span class="badge bg-info ms-1" t-esc="cp.stage_id[1]"/>
                                    </div>
                                    <button class="btn btn-sm btn-link text-danger p-0" 
                                            t-on-click="() => this.removeFromPipeline(cp.id)" title="Remover">
                                        <i class="fa fa-times"/>
                                    </button>
                                </div>
                            </t>
                        </div>
                        <div t-else="" class="no-pipelines">
                            <p class="text-muted small mb-0">Nenhum fluxo atribuído</p>
                        </div>
                    </div>

                    <div class="contact-actions">
                        <button class="action-btn primary" t-on-click="createOpportunity">
                            <i class="fa fa-dollar"/>
                            <span>Criar Oportunidade</span>
                            <i class="fa fa-chevron-right chevron"/>
                        </button>
                        <button class="action-btn" t-on-click="viewPartner">
                            <i class="fa fa-user"/>
                            <span>Ver/Criar Contato</span>
                            <i class="fa fa-chevron-right chevron"/>
                        </button>
                    </div>
                </div>
        </div>

        <!-- ADD CHANNEL MODAL -->
        <div t-if="state.showChannelModal" class="channel-modal-wrapper">
            <div class="bader-modal-overlay" t-on-click="closeChannelModal">
                <div class="bader-modal" t-on-click.stop="">
                    <div class="bader-modal-header">
                        <h4><i class="fa fa-whatsapp"/> Conectar WhatsApp</h4>
                        <button class="btn-close" t-on-click="closeChannelModal"/>
                    </div>
                    <div class="bader-modal-body">
                        <!-- Step 1: Enter Name -->
                        <div t-if="state.channelStep === 1" class="channel-step-1">
                            <div class="mb-3">
                                <label class="form-label">Nome do Canal</label>
                                <input type="text" class="form-control form-control-lg" 
                                    placeholder="Ex: Bader WhatsApp" 
                                    t-model="state.newChannelName"/>
                            </div>
                            <button class="btn btn-success btn-lg w-100" 
                                t-on-click="createChannel" 
                                t-att-disabled="!state.newChannelName.trim() || state.creatingChannel">
                                <span t-if="state.creatingChannel">
                                    <i class="fa fa-spinner fa-spin"/> Criando...
                                </span>
                                <span t-else="">
                                    <i class="fa fa-arrow-right"/> Continuar
                                </span>
                            </button>
                        </div>
                        
                        <!-- Step 2: Show QR Code -->
                        <div t-if="state.channelStep === 2" class="channel-step-2">
                            <div class="text-center">
                                <p class="mb-3">Escaneie o QR Code com o WhatsApp</p>
                                <div t-if="state.qrCodeData" class="qr-data">
                                    <div class="qr-container">
                                        <img t-att-src="'data:image/png;base64,' + state.qrCodeData" 
                                            class="qr-code-img" alt="QR Code"/>
                                    </div>
                                    <p class="small text-muted mt-3">
                                        <i class="fa fa-mobile"/> Abra o WhatsApp &gt; Dispositivos Vinculados &gt; Vincular Dispositivo
                                    </p>
                                </div>
                                <div t-else="" class="qr-loading">
                                    <i class="fa fa-spinner fa-spin fa-3x"/>
                                    <p class="mt-2">A obter QR Code...</p>
                                </div>
                                <button class="btn btn-outline-secondary mt-3" t-on-click="refreshQRCode">
                                    <i class="fa fa-refresh"/> Atualizar QR Code
                                </button>
                            </div>
                        </div>
                        
                        <!-- Step 3: Connected -->
                        <div t-if="state.channelStep === 3" class="channel-step-3">
                            <div class="text-center">
                                <div class="success-icon">
                                    <i class="fa fa-check-circle text-success"/>
                                </div>
                                <h4 class="mt-3">Conectado!</h4>
                                <p class="text-muted" t-esc="state.connectedPhone"/>
                                <button class="btn btn-success btn-lg w-100 mt-3" t-on-click="closeChannelModal">
                                    <i class="fa fa-check"/> Concluído
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- ADD TO PIPELINE MODAL -->
        <div t-if="state.showPipelineModal" class="pipeline-modal-wrapper">
            <div class="bader-modal-overlay" t-on-click="closePipelineModal">
                <div class="bader-modal" t-on-click.stop="" style="max-width: 400px;">
                    <div class="bader-modal-header">
                        <h4><i class="fa fa-columns"/> Adicionar a Pipeline</h4>
                        <button class="btn-close" t-on-click="closePipelineModal"/>
                    </div>
                    <div class="bader-modal-body">
                        <div t-if="availablePipelinesForModal.length" class="pipeline-select-form">
                            <div class="mb-3">
                                <label class="form-label">Selecione o pipeline:</label>
                                <select class="form-select" 
                                        t-on-change="onPipelineModalChange">
                                    <option value="">-- Escolher --</option>
                                    <t t-foreach="availablePipelinesForModal" t-as="p" t-key="p.id">
                                        <option t-att-value="p.id">
                                            <t t-esc="p.icon"/> <t t-esc="p.name"/>
                                        </option>
                                    </t>
                                </select>
                            </div>
                            <button class="btn btn-primary w-100" t-on-click="addToPipeline"
                                    t-att-disabled="!state.pipelineModalPipelineId">
                                <i class="fa fa-plus"/> Adicionar
                            </button>
                        </div>
                        <div t-else="" class="no-pipelines-msg">
                            <p class="text-muted">Esta conversa já está em todos os pipelines disponíveis.</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- NEW CONVERSATION MODAL -->
        <div t-if="state.showNewConversationModal" class="new-conv-modal-wrapper">
            <div class="bader-modal-overlay" t-on-click="closeNewConversationModal">
                <div class="bader-modal new-conv-modal" t-on-click.stop="">
                    <div class="bader-modal-header">
                        <h4><i class="fa fa-comment"/> Nova Conversa</h4>
                        <button class="btn-close" t-on-click="closeNewConversationModal"/>
                    </div>
                    <div class="bader-modal-body">
                        <!-- Channel Selector (if multiple) -->
                        <div t-if="state.channels.length > 1" class="new-conv-channel-select mb-3">
                            <label class="form-label small text-muted">Canal WhatsApp:</label>
                            <div class="d-flex gap-2 flex-wrap">
                                <t t-foreach="state.channels" t-as="ch" t-key="ch.id">
                                    <button t-attf-class="btn btn-sm {{ state.selectedChannelId === ch.id ? 'btn-success' : 'btn-outline-secondary' }}"
                                            t-on-click="() => this.state.selectedChannelId = ch.id">
                                        <i class="fa fa-whatsapp"/> <t t-esc="ch.name"/>
                                    </button>
                                </t>
                            </div>
                        </div>

                        <!-- Search Input -->
                        <div class="new-conv-search-wrapper">
                            <i class="fa fa-search new-conv-search-icon"/>
                            <input type="text" class="form-control new-conv-search-input"
                                   placeholder="Pesquisar contacto por nome, telefone ou email..."
                                   t-att-value="state.contactSearchQuery"
                                   t-on-input="onContactSearchInput"
                                   autofocus="1"/>
                            <span t-if="state.searchingContacts" class="search-spinner-wrap">
                                <i class="fa fa-spinner fa-spin new-conv-search-spinner"/>
                            </span>
                        </div>

                        <!-- Results -->
                        <div class="new-conv-results">
                            <div t-if="state.searchingContacts and !state.contactSearchResults.length" class="new-conv-empty">
                                <i class="fa fa-spinner fa-spin fa-2x"/>
                                <p>A pesquisar...</p>
                            </div>
                            <div t-elif="!state.contactSearchQuery" class="new-conv-empty">
                                <i class="fa fa-address-book fa-3x"/>
                                <p>Pesquise um contacto do Odoo</p>
                                <span class="text-muted small">Procure por nome, telefone ou email</span>
                            </div>
                            <div t-elif="state.contactSearchQuery and !state.searchingContacts and !state.contactSearchResults.length" class="new-conv-empty">
                                <i class="fa fa-user-times fa-2x"/>
                                <p>Nenhum contacto encontrado</p>
                                <span class="text-muted small">Tente outro nome ou número</span>
                            </div>
                            <div t-else="" class="contact-search-results">
                                <t t-foreach="state.contactSearchResults" t-as="contact" t-key="contact.id">
                                    <div class="new-conv-contact" t-on-click="() => this.startConversation(contact)">
                                        <div class="new-conv-contact-avatar">
                                            <img t-if="contact.has_image" t-attf-src="/web/image/res.partner/{{ contact.id }}/image_128" alt="Avatar"/>
                                            <span t-else="" t-attf-class="avatar-initials {{ getAvatarColor(contact.id) }}">
                                                <t t-esc="getContactInitials(contact.name)"/>
                                            </span>
                                        </div>
                                        <div class="new-conv-contact-info">
                                            <div class="new-conv-contact-name" t-esc="contact.name"/>
                                            <div class="new-conv-contact-details">
                                                <span class="new-conv-phone">
                                                    <i class="fa fa-phone"/> <t t-esc="contact.display_phone"/>
                                                </span>
                                                <span t-if="contact.company_name" class="new-conv-company">
                                                    <i class="fa fa-building-o"/> <t t-esc="contact.company_name"/>
                                                </span>
                                            </div>
                                        </div>
                                        <div class="new-conv-contact-action">
                                            <i class="fa fa-whatsapp"/>
                                        </div>
                                    </div>
                                </t>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </t>
</templates>
