<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="ir_cron_bader_inbox_health_alert" model="ir.cron">
            <field name="name">Bader Inbox: Health Alert</field>
            <field name="model_id" ref="model_bader_inbox_channel"/>
            <field name="state">code</field>
            <field name="code">model.cron_health_alert()</field>
            <field name="interval_number">10</field>
            <field name="interval_type">minutes</field>
            <field name="numbercall">-1</field>
            <field name="doall" eval="False"/>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>
