<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <!-- Evolution API URL - OdontoWave WhatsApp Server (Production) -->
    <record id="bader_inbox_evolution_url" model="ir.config_parameter">
        <field name="key">bader_inbox.evolution_url</field>
        <field name="value">https://whatsapp.bader.es</field>
    </record>
    <!-- Evolution API Key - SESSION_SECRET from server -->
    <record id="bader_inbox_evolution_key" model="ir.config_parameter">
        <field name="key">bader_inbox.evolution_key</field>
        <field name="value"></field>
    </record>
</odoo>
