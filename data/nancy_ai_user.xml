<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Partner for NancyAI bot — used as author_id for automated outbound messages
             (scheduled messages, AI agent replies, chatbot). Shows up as "NancyAI"
             in the Bader Inbox chat instead of the generic OdooBot. -->
        <record id="partner_nancy_ai" model="res.partner">
            <field name="name">NancyAI</field>
            <field name="email">nancyai@bader.local</field>
            <field name="is_company" eval="False"/>
            <field name="active" eval="True"/>
            <field name="comment">Automated assistant for Bader Inbox — sends scheduled messages, AI-generated replies, and chatbot flows. Not a human user.</field>
        </record>

        <record id="user_nancy_ai" model="res.users">
            <field name="name">NancyAI</field>
            <field name="login">nancyai@bader.local</field>
            <field name="partner_id" ref="partner_nancy_ai"/>
            <field name="active" eval="True"/>
            <field name="share" eval="False"/>
            <field name="groups_id" eval="[
                (4, ref('base.group_user')),
                (4, ref('bader_inbox.group_bader_inbox_user')),
            ]"/>
        </record>
    </data>
</odoo>
