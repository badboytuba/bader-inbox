<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Conversation Tree -->
    <record id="view_bader_inbox_conversation_tree" model="ir.ui.view">
        <field name="name">bader.inbox.conversation.tree</field>
        <field name="model">bader.inbox.conversation</field>
        <field name="arch" type="xml">
            <tree>
                <field name="display_name"/>
                <field name="phone"/>
                <field name="channel_id"/>
                <field name="last_message"/>
                <field name="last_message_date"/>
                <field name="unread_count" widget="badge"/>
                <field name="state" widget="badge" decoration-success="state == 'open'" decoration-warning="state == 'pending'" decoration-muted="state == 'resolved'"/>
                <field name="assigned_user_id" widget="many2one_avatar_user"/>
            </tree>
        </field>
    </record>

    <!-- Conversation Form -->
    <record id="view_bader_inbox_conversation_form" model="ir.ui.view">
        <field name="name">bader.inbox.conversation.form</field>
        <field name="model">bader.inbox.conversation</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_assign_to_me" type="object" string="👤 Atribuir a Mim" class="btn-primary"/>
                    <button name="action_close" type="object" string="✅ Resolver" attrs="{'invisible': [('state', '=', 'resolved')]}"/>
                    <button name="action_reopen" type="object" string="🔄 Reabrir" attrs="{'invisible': [('state', '!=', 'resolved')]}"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <group string="📞 Contato">
                            <field name="display_name" readonly="1"/>
                            <field name="phone" readonly="1"/>
                            <field name="contact_name"/>
                            <field name="partner_id"/>
                        </group>
                        <group string="📱 Canal">
                            <field name="channel_id" readonly="1"/>
                            <field name="assigned_user_id"/>
                            <field name="tag_ids" widget="many2many_tags"/>
                        </group>
                    </group>
                    <group string="💼 CRM">
                        <field name="lead_id"/>
                        <button name="action_create_opportunity" type="object" string="➕ Criar Oportunidade" class="btn-secondary"/>
                    </group>
                    <notebook>
                        <page string="💬 Mensagens" name="messages">
                            <field name="message_ids" readonly="1">
                                <tree>
                                    <field name="create_date"/>
                                    <field name="direction" widget="badge"/>
                                    <field name="message_type"/>
                                    <field name="content"/>
                                    <field name="status" widget="badge"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <!-- Conversation Kanban -->
    <record id="view_bader_inbox_conversation_kanban" model="ir.ui.view">
        <field name="name">bader.inbox.conversation.kanban</field>
        <field name="model">bader.inbox.conversation</field>
        <field name="arch" type="xml">
            <kanban>
                <field name="display_name"/>
                <field name="phone"/>
                <field name="last_message"/>
                <field name="last_message_date"/>
                <field name="unread_count"/>
                <field name="state"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_card oe_kanban_global_click">
                            <div class="o_kanban_record_top">
                                <strong><field name="display_name"/></strong>
                                <span t-if="record.unread_count.raw_value > 0" class="badge bg-success"><t t-esc="record.unread_count.raw_value"/></span>
                            </div>
                            <div class="text-muted"><field name="phone"/></div>
                            <div class="o_kanban_record_body">
                                <small class="text-truncate"><field name="last_message"/></small>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Search -->
    <record id="view_bader_inbox_conversation_search" model="ir.ui.view">
        <field name="name">bader.inbox.conversation.search</field>
        <field name="model">bader.inbox.conversation</field>
        <field name="arch" type="xml">
            <search>
                <field name="display_name"/>
                <field name="phone"/>
                <filter name="unread" string="Não Lidas" domain="[('unread_count', '>', 0)]"/>
                <filter name="mine" string="Minhas" domain="[('assigned_user_id', '=', uid)]"/>
                <filter name="open" string="Abertas" domain="[('state', '=', 'open')]"/>
                <group expand="0" string="Agrupar Por">
                    <filter name="group_channel" string="Canal" context="{'group_by': 'channel_id'}"/>
                    <filter name="group_state" string="Estado" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Actions -->
    <record id="action_bader_inbox_conversation" model="ir.actions.act_window">
        <field name="name">📥 Inbox</field>
        <field name="res_model">bader.inbox.conversation</field>
        <field name="view_mode">kanban,tree,form</field>
        <field name="context">{'search_default_open': 1}</field>
    </record>

    <record id="action_bader_inbox_my_assignments" model="ir.actions.act_window">
        <field name="name">👤 Minhas Conversas</field>
        <field name="res_model">bader.inbox.conversation</field>
        <field name="view_mode">kanban,tree,form</field>
        <field name="context">{'search_default_mine': 1}</field>
    </record>

    <record id="action_bader_inbox_unread" model="ir.actions.act_window">
        <field name="name">🔔 Não Lidas</field>
        <field name="res_model">bader.inbox.conversation</field>
        <field name="view_mode">kanban,tree,form</field>
        <field name="context">{'search_default_unread': 1}</field>
    </record>
</odoo>
