<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Tree View -->
    <record id="view_bader_inbox_duplicate_group_tree" model="ir.ui.view">
        <field name="name">bader.inbox.duplicate.group.tree</field>
        <field name="model">bader.inbox.duplicate.group</field>
        <field name="arch" type="xml">
            <tree decoration-muted="state == 'ignored'" decoration-success="state == 'merged'">
                <header>
                    <button name="action_scan_duplicates" type="object" string="🔍 Escanear Duplicados"
                        class="btn-primary" context="{'scan': True}"/>
                    <button name="action_merge_all" type="object" string="🔗 Fusionar Todos"
                        class="btn-warning" confirm="¿Fusionar TODOS los grupos pendientes? Se archivaran los contactos duplicados."/>
                </header>
                <field name="phone_display"/>
                <field name="partner_count"/>
                <field name="partner_names"/>
                <field name="state" widget="badge"
                    decoration-info="state == 'pending'"
                    decoration-success="state == 'merged'"
                    decoration-muted="state == 'ignored'"/>
                <button name="action_merge" type="object" string="Fusionar"
                    class="btn-primary btn-sm" icon="fa-compress"
                    attrs="{'invisible': [('state', '!=', 'pending')]}"/>
                <button name="action_ignore" type="object" string="Ignorar"
                    class="btn-secondary btn-sm" icon="fa-eye-slash"
                    attrs="{'invisible': [('state', '!=', 'pending')]}"/>
                <button name="action_open_partners" type="object" string="Ver"
                    class="btn-link btn-sm" icon="fa-users"/>
            </tree>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_bader_inbox_duplicate_group_form" model="ir.ui.view">
        <field name="name">bader.inbox.duplicate.group.form</field>
        <field name="model">bader.inbox.duplicate.group</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_merge" type="object" string="🔗 Fusionar Duplicados"
                        class="btn-primary"
                        attrs="{'invisible': [('state', '!=', 'pending')]}"
                        confirm="¿Fusionar estos contactos? Se mantendrá el mejor y se archivarán los demás."/>
                    <button name="action_ignore" type="object" string="Ignorar"
                        class="btn-secondary"
                        attrs="{'invisible': [('state', '!=', 'pending')]}"/>
                    <field name="state" widget="statusbar" statusbar_visible="pending,merged,ignored"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="phone_display"/>
                            <field name="phone_normalized"/>
                        </group>
                        <group>
                            <field name="partner_count"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Contactos Duplicados" name="partners">
                            <field name="partner_ids" nolabel="1">
                                <tree>
                                    <field name="name"/>
                                    <field name="phone"/>
                                    <field name="mobile"/>
                                    <field name="email"/>
                                    <field name="city"/>
                                    <field name="create_date"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Search View -->
    <record id="view_bader_inbox_duplicate_group_search" model="ir.ui.view">
        <field name="name">bader.inbox.duplicate.group.search</field>
        <field name="model">bader.inbox.duplicate.group</field>
        <field name="arch" type="xml">
            <search>
                <field name="phone_display"/>
                <field name="partner_names"/>
                <filter name="pending" string="Pendientes" domain="[('state', '=', 'pending')]"/>
                <filter name="merged" string="Fusionados" domain="[('state', '=', 'merged')]"/>
                <filter name="ignored" string="Ignorados" domain="[('state', '=', 'ignored')]"/>
                <separator/>
                <filter name="many" string="3+ Duplicados" domain="[('partner_count', '>=', 3)]"/>
            </search>
        </field>
    </record>

    <!-- Action: scans on open, then shows results -->
    <record id="action_bader_inbox_duplicate_scan_and_open" model="ir.actions.server">
        <field name="name">Contactos Duplicados</field>
        <field name="model_id" ref="model_bader_inbox_duplicate_group"/>
        <field name="state">code</field>
        <field name="code">
model.action_scan_duplicates()
action = {
    "type": "ir.actions.act_window",
    "name": "Contactos Duplicados",
    "res_model": "bader.inbox.duplicate.group",
    "view_mode": "tree,form",
    "context": {"search_default_pending": 1},
}
        </field>
    </record>

    <!-- Fallback window action (for direct navigation) -->
    <record id="action_bader_inbox_duplicate_group" model="ir.actions.act_window">
        <field name="name">Contactos Duplicados</field>
        <field name="res_model">bader.inbox.duplicate.group</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{'search_default_pending': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No hay duplicados detectados
            </p>
            <p>
                Haga clic en <strong>"Escanear Duplicados"</strong> para buscar contactos con el mismo número de teléfono.
            </p>
        </field>
    </record>
</odoo>
