<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Root menu - opens OWL Inbox -->
    <menuitem id="menu_bader_inbox_root" name="Bader Inbox" sequence="35" 
        web_icon="bader_inbox,static/description/icon.png"
        action="action_bader_inbox_main"
        groups="base.group_user"/>

    <!-- Old menus hidden, configuration only -->
    <menuitem id="menu_bader_inbox_config" name="⚙️ Configuração" 
        parent="menu_bader_inbox_root" 
        sequence="100" 
        groups="base.group_user"/>
    
    <menuitem id="menu_bader_inbox_channels" name="📱 Canais WhatsApp" 
        parent="menu_bader_inbox_config" 
        action="action_bader_inbox_channel" 
        sequence="10"/>
    
    <menuitem id="menu_bader_inbox_templates" name="📝 Templates" 
        parent="menu_bader_inbox_config" 
        action="action_bader_inbox_template" 
        sequence="20"/>
    
    <menuitem id="menu_bader_inbox_chatbot" name="🤖 Automações" 
        parent="menu_bader_inbox_config" 
        action="action_bader_inbox_chatbot" 
        sequence="30"/>

    <menuitem id="menu_bader_inbox_conversations" name="📋 Conversas (Lista)" 
        parent="menu_bader_inbox_config" 
        action="action_bader_inbox_conversation" 
        sequence="40"/>
</odoo>
