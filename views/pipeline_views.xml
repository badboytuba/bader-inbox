<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ══════════════════════════════════════ -->
    <!--  PIPELINE VIEWS (Manage Pipelines)     -->
    <!-- ══════════════════════════════════════ -->
    
    <!-- Pipeline Tree -->
    <record id="view_bader_inbox_pipeline_tree" model="ir.ui.view">
        <field name="name">bader.inbox.pipeline.tree</field>
        <field name="model">bader.inbox.pipeline</field>
        <field name="arch" type="xml">
            <tree>
                <field name="sequence" widget="handle"/>
                <field name="icon"/>
                <field name="name"/>
                <field name="user_id" widget="many2one_avatar_user" string="Utilizador"/>
                <field name="stage_count"/>
                <field name="assignment_count"/>
                <field name="active" invisible="1"/>
            </tree>
        </field>
    </record>

    <!-- Pipeline Form (with inline stages) -->
    <record id="view_bader_inbox_pipeline_form" model="ir.ui.view">
        <field name="name">bader.inbox.pipeline.form</field>
        <field name="model">bader.inbox.pipeline</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="icon" class="oe_inline" style="font-size: 1.5em;"/>
                            <field name="name" placeholder="Nome do Pipeline"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="user_id" string="Utilizador" options="{'no_create': True}" widget="many2one_avatar_user"/>
                            <field name="description" placeholder="Descrição do fluxo..."/>
                            <field name="color" widget="color_picker"/>
                            <field name="active"/>
                        </group>
                        <group>
                            <field name="assignment_count" string="Conversas Ativas"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="📋 Etapas" name="stages">
                            <field name="stage_ids">
                                <tree editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="name"/>
                                    <field name="fold"/>
                                    <field name="description"/>
                                    <field name="assignment_count" string="Conversas"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Pipeline Action -->
    <record id="action_bader_inbox_pipeline" model="ir.actions.act_window">
        <field name="name">📊 Pipelines</field>
        <field name="res_model">bader.inbox.pipeline</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Crie seu primeiro pipeline!</p>
            <p>Pipelines organizam suas conversas em fluxos visuais tipo Kanban.</p>
            <p>Exemplos: Clínica, Laboratório, Mayorista, Estudantes.</p>
        </field>
    </record>

    <!-- ══════════════════════════════════════ -->
    <!--  KANBAN VIEW (Conversation Pipeline)   -->
    <!-- ══════════════════════════════════════ -->
    
    <!-- Kanban View for Pipeline Assignments -->
    <record id="view_bader_inbox_conv_pipeline_kanban" model="ir.ui.view">
        <field name="name">bader.inbox.conversation.pipeline.kanban</field>
        <field name="model">bader.inbox.conversation.pipeline</field>
        <field name="arch" type="xml">
            <kanban default_group_by="stage_id" class="o_kanban_small_column o_bader_pipeline_kanban">
                <field name="stage_id"/>
                <field name="pipeline_id"/>
                <field name="contact_name"/>
                <field name="phone"/>
                <field name="last_message"/>
                <field name="unread_count"/>
                <field name="priority"/>
                <field name="kanban_state"/>
                <field name="assigned_user_id"/>
                <field name="conversation_id"/>
                <field name="color"/>
                <templates>
                    <t t-name="kanban-box">
                        <div t-attf-class="oe_kanban_card oe_kanban_global_click o_bader_pipeline_card">
                            <div class="oe_kanban_content">
                                <!-- Header: priority + name -->
                                <div class="o_kanban_record_top">
                                    <div class="o_kanban_record_headings">
                                        <strong class="o_kanban_record_title">
                                            <field name="contact_name"/>
                                        </strong>
                                    </div>
                                    <div class="o_kanban_record_top_right">
                                        <field name="priority" widget="priority"/>
                                    </div>
                                </div>
                                
                                <!-- Phone -->
                                <div class="text-muted small">
                                    📱 <field name="phone"/>
                                </div>
                                
                                <!-- Last message preview -->
                                <div class="o_kanban_record_body mt-1">
                                    <small class="text-muted" style="display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;">
                                        <field name="last_message"/>
                                    </small>
                                </div>
                                
                                <!-- Footer: unread badge + avatar -->
                                <div class="o_kanban_record_bottom mt-2">
                                    <div class="oe_kanban_bottom_left">
                                        <span t-if="record.unread_count.raw_value > 0" class="badge bg-danger">
                                            <field name="unread_count"/> não lidas
                                        </span>
                                    </div>
                                    <div class="oe_kanban_bottom_right">
                                        <field name="assigned_user_id" widget="many2one_avatar_user"/>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Tree View for Pipeline Assignments -->
    <record id="view_bader_inbox_conv_pipeline_tree" model="ir.ui.view">
        <field name="name">bader.inbox.conversation.pipeline.tree</field>
        <field name="model">bader.inbox.conversation.pipeline</field>
        <field name="arch" type="xml">
            <tree>
                <field name="contact_name"/>
                <field name="phone"/>
                <field name="pipeline_id"/>
                <field name="stage_id"/>
                <field name="priority"/>
                <field name="assigned_user_id"/>
                <field name="unread_count"/>
                <field name="entered_date"/>
            </tree>
        </field>
    </record>

    <!-- Form View for Pipeline Assignments -->
    <record id="view_bader_inbox_conv_pipeline_form" model="ir.ui.view">
        <field name="name">bader.inbox.conversation.pipeline.form</field>
        <field name="model">bader.inbox.conversation.pipeline</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <field name="stage_id" widget="statusbar" options="{'clickable': '1'}" domain="[('pipeline_id', '=', pipeline_id)]"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="contact_name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group string="📊 Pipeline">
                            <field name="pipeline_id"/>
                            <field name="priority" widget="priority"/>
                            <field name="kanban_state" widget="state_selection"/>
                            <field name="assigned_user_id"/>
                        </group>
                        <group string="📱 Conversa">
                            <field name="conversation_id"/>
                            <field name="phone"/>
                            <field name="unread_count"/>
                            <field name="entered_date"/>
                        </group>
                    </group>
                    <group string="📝 Notas">
                        <field name="notes" nolabel="1" placeholder="Notas sobre este contacto neste pipeline..."/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Search View -->
    <record id="view_bader_inbox_conv_pipeline_search" model="ir.ui.view">
        <field name="name">bader.inbox.conversation.pipeline.search</field>
        <field name="model">bader.inbox.conversation.pipeline</field>
        <field name="arch" type="xml">
            <search>
                <field name="contact_name"/>
                <field name="phone"/>
                <field name="pipeline_id"/>
                <field name="stage_id"/>
                <field name="assigned_user_id"/>
                <filter name="my_assignments" string="Minhas" domain="[('assigned_user_id', '=', uid)]"/>
                <filter name="unread" string="Não Lidas" domain="[('unread_count', '>', 0)]"/>
                <separator/>
                <filter name="priority_urgent" string="Urgente" domain="[('priority', '=', '3')]"/>
                <filter name="priority_high" string="Alta" domain="[('priority', '=', '2')]"/>
                <group expand="1" string="Agrupar por">
                    <filter string="Pipeline" name="group_pipeline" context="{'group_by': 'pipeline_id'}"/>
                    <filter string="Etapa" name="group_stage" context="{'group_by': 'stage_id'}"/>
                    <filter string="Responsável" name="group_user" context="{'group_by': 'assigned_user_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Pipeline Kanban Action -->
    <record id="action_bader_inbox_pipeline_kanban" model="ir.actions.act_window">
        <field name="name">📊 Pipeline Kanban</field>
        <field name="res_model">bader.inbox.conversation.pipeline</field>
        <field name="view_mode">kanban,tree,form</field>
        <field name="search_view_id" ref="view_bader_inbox_conv_pipeline_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Nenhuma conversa neste pipeline!</p>
            <p>Adicione conversas ao pipeline pela vista de chat.</p>
        </field>
    </record>

</odoo>
