<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ══════════════════════════════════════ -->
    <!--  TICKET VIEWS                          -->
    <!-- ══════════════════════════════════════ -->

    <record id="view_bader_inbox_ticket_kanban" model="ir.ui.view">
        <field name="name">bader.inbox.ticket.kanban</field>
        <field name="model">bader.inbox.ticket</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" class="o_kanban_small_column" records_draggable="1">
                <field name="name"/>
                <field name="ticket_type"/>
                <field name="priority"/>
                <field name="state"/>
                <field name="user_id"/>
                <field name="assigned_to_id"/>
                <field name="kanban_color"/>
                <field name="activity_ids"/>
                <templates>
                    <t t-name="kanban-box">
                        <div t-attf-class="oe_kanban_card oe_kanban_global_click #{kanban_color(record.kanban_color.raw_value)}">
                            <div class="o_kanban_record_top">
                                <div class="o_kanban_record_headings">
                                    <strong class="o_kanban_record_title">
                                        <field name="name"/>
                                    </strong>
                                </div>
                                <field name="priority" widget="priority"/>
                            </div>
                            <div class="o_kanban_record_body">
                                <span t-attf-class="badge #{record.ticket_type.raw_value === 'bug' ? 'text-bg-danger' : record.ticket_type.raw_value === 'improvement' ? 'text-bg-info' : 'text-bg-warning'}">
                                    <field name="ticket_type"/>
                                </span>
                            </div>
                            <div class="o_kanban_record_bottom">
                                <div class="oe_kanban_bottom_left">
                                    <field name="activity_ids" widget="kanban_activity"/>
                                </div>
                                <div class="oe_kanban_bottom_right">
                                    <field name="user_id" widget="many2one_avatar_user"/>
                                    <field name="assigned_to_id" widget="many2one_avatar_user"/>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_bader_inbox_ticket_tree" model="ir.ui.view">
        <field name="name">bader.inbox.ticket.tree</field>
        <field name="model">bader.inbox.ticket</field>
        <field name="arch" type="xml">
            <tree decoration-danger="state=='new' and ticket_type=='bug'"
                  decoration-muted="state in ('resolved','cancelled')"
                  decoration-info="state=='in_progress'">
                <field name="name"/>
                <field name="ticket_type"/>
                <field name="priority" widget="priority"/>
                <field name="user_id" widget="many2one_avatar_user"/>
                <field name="assigned_to_id" widget="many2one_avatar_user"/>
                <field name="state" widget="badge"
                       decoration-success="state=='resolved'"
                       decoration-info="state=='in_progress'"
                       decoration-warning="state=='waiting_info'"
                       decoration-muted="state=='cancelled'"/>
                <field name="create_date"/>
                <field name="resolved_date" optional="hide"/>
                <field name="activity_ids" widget="list_activity"/>
            </tree>
        </field>
    </record>

    <record id="view_bader_inbox_ticket_form" model="ir.ui.view">
        <field name="name">bader.inbox.ticket.form</field>
        <field name="model">bader.inbox.ticket</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_start" string="Iniciar" type="object"
                            class="btn-primary"
                            states="new,analyzing,waiting_info"/>
                    <button name="action_request_info" string="Pedir info" type="object"
                            states="analyzing,in_progress"/>
                    <button name="action_resolve" string="Resolver" type="object"
                            class="btn-success"
                            states="analyzing,in_progress,waiting_info"/>
                    <button name="action_cancel" string="Cancelar" type="object"
                            states="new,analyzing,in_progress,waiting_info"/>
                    <button name="action_reopen" string="Reabrir" type="object"
                            states="resolved,cancelled"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="new,analyzing,in_progress,resolved"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name" class="oe_edit_only"/>
                        <h1>
                            <field name="name" placeholder="Título do ticket..."/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="ticket_type"/>
                            <field name="priority" widget="priority"/>
                            <field name="user_id" options="{'no_create': True}"
                                   widget="many2one_avatar_user"/>
                        </group>
                        <group>
                            <field name="assigned_to_id" options="{'no_create': True}"
                                   widget="many2one_avatar_user"/>
                            <field name="resolved_date" readonly="1"
                                   attrs="{'invisible': [('resolved_date','=',False)]}"/>
                            <field name="commit_ref"
                                   attrs="{'invisible': [('state','not in',['resolved'])]}"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="📝 Descrição" name="description">
                            <field name="description"
                                   placeholder="Descreve o problema ou melhoria. Podes colar imagens diretamente aqui..."
                                   options="{'style-inline': true}"/>
                        </page>
                        <page string="📎 Anexos" name="attachments">
                            <field name="attachment_ids" widget="many2many_binary"/>
                        </page>
                        <page string="✅ Resolução" name="resolution"
                              attrs="{'invisible': [('state','not in',['in_progress','resolved'])]}">
                            <field name="resolution_notes"
                                   placeholder="Detalhes de como o ticket foi resolvido..."/>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="view_bader_inbox_ticket_search" model="ir.ui.view">
        <field name="name">bader.inbox.ticket.search</field>
        <field name="model">bader.inbox.ticket</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="user_id"/>
                <field name="assigned_to_id"/>
                <filter string="Meus tickets" name="my_tickets"
                        domain="[('user_id','=',uid)]"/>
                <filter string="Atribuídos a mim" name="assigned_to_me"
                        domain="[('assigned_to_id','=',uid)]"/>
                <separator/>
                <filter string="Abertos" name="open"
                        domain="[('state','in',['new','analyzing','in_progress','waiting_info'])]"/>
                <filter string="Resolvidos" name="resolved"
                        domain="[('state','=','resolved')]"/>
                <separator/>
                <filter string="🐛 Bugs" name="bugs" domain="[('ticket_type','=','bug')]"/>
                <filter string="✨ Melhorias" name="improvements" domain="[('ticket_type','=','improvement')]"/>
                <filter string="❓ Dúvidas" name="questions" domain="[('ticket_type','=','question')]"/>
                <separator/>
                <filter string="Alta prioridade" name="high_prio"
                        domain="[('priority','in',['2','3'])]"/>
                <group expand="0" string="Agrupar por">
                    <filter string="Estado" name="group_state" context="{'group_by':'state'}"/>
                    <filter string="Tipo" name="group_type" context="{'group_by':'ticket_type'}"/>
                    <filter string="Solicitante" name="group_user" context="{'group_by':'user_id'}"/>
                    <filter string="Prioridade" name="group_priority" context="{'group_by':'priority'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_bader_inbox_ticket" model="ir.actions.act_window">
        <field name="name">Tickets</field>
        <field name="res_model">bader.inbox.ticket</field>
        <field name="view_mode">kanban,tree,form</field>
        <field name="search_view_id" ref="view_bader_inbox_ticket_search"/>
        <field name="context">{'search_default_open': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Nenhum ticket ainda.
            </p>
            <p>
                Abre tickets para reportar bugs ou pedir melhorias no Bader Inbox.
            </p>
        </field>
    </record>

</odoo>
