<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ======================================== -->
    <!-- PHONE WHATSAPP WIDGET VIEWS              -->
    <!-- Adds WhatsApp click-to-chat to phone fields -->
    <!-- ======================================== -->

    <!-- RES.PARTNER (Contacts) - Form View -->
    <record id="view_partner_form_phone_whatsapp" model="ir.ui.view">
        <field name="name">res.partner.form.phone.whatsapp</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="priority">100</field>
        <field name="arch" type="xml">
            <!-- Phone field -->
            <xpath expr="//field[@name='phone']" position="attributes">
                <attribute name="widget">phone_whatsapp</attribute>
            </xpath>
            <!-- Mobile field -->
            <xpath expr="//field[@name='mobile']" position="attributes">
                <attribute name="widget">phone_whatsapp</attribute>
            </xpath>
        </field>
    </record>

    <!-- RES.PARTNER (Contacts) - Kanban View -->
    <record id="view_partner_kanban_phone_whatsapp" model="ir.ui.view">
        <field name="name">res.partner.kanban.phone.whatsapp</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.res_partner_kanban_view"/>
        <field name="priority">100</field>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='phone']" position="attributes">
                <attribute name="widget">phone_whatsapp</attribute>
            </xpath>
            <xpath expr="//field[@name='mobile']" position="attributes">
                <attribute name="widget">phone_whatsapp</attribute>
            </xpath>
        </field>
    </record>

    <!-- CRM.LEAD (Leads/Opportunities) - Form View -->
