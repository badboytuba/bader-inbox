        <field name="name">crm.lead.form.phone.whatsapp</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.crm_lead_view_form"/>
        <field name="priority">100</field>
        <field name="arch" type="xml">
            <!-- Phone field -->
            <xpath expr="//field[@name='phone']" position="attributes">
                <attribute name="widget">phone_whatsapp</attribute>
            </xpath>
            <!-- Mobile field -->
            <xpath expr="//field[@name='mobile']" position="attributes">
                <attribute name="widget">phone_whatsapp</attribute>
            </xpath>
        </field>
    </record>

    <!-- CRM.LEAD - Kanban View -->
    <record id="view_crm_lead_kanban_phone_whatsapp" model="ir.ui.view">
        <field name="name">crm.lead.kanban.phone.whatsapp</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.crm_case_kanban_view_leads"/>
        <field name="priority">100</field>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='phone']" position="attributes">
                <attribute name="widget">phone_whatsapp</attribute>
            </xpath>
            <xpath expr="//field[@name='mobile']" position="attributes">
                <attribute name="widget">phone_whatsapp</attribute>
            </xpath>
        </field>
    </record>

    <!-- CRM Opportunities Pipeline Kanban -->
    <record id="view_crm_opportunity_kanban_phone_whatsapp" model="ir.ui.view">
        <field name="name">crm.opportunity.kanban.phone.whatsapp</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.crm_case_kanban_view"/>
        <field name="priority">100</field>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='phone']" position="attributes">
                <attribute name="widget">phone_whatsapp</attribute>
            </xpath>
            <xpath expr="//field[@name='mobile']" position="attributes">
                <attribute name="widget">phone_whatsapp</attribute>
            </xpath>
        </field>
    </record>

</odoo>
